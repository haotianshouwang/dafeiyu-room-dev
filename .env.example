# Local community API target. The browser always calls same-origin
# /community-api, and Vite proxies that path to this server.
VITE_COMMUNITY_API_PROXY_TARGET=https://dsh.xn--n6qv0quslfsn.top
# The standalone local game server uses this target too (desktop has its own default).
# DAFEIYU_COMMUNITY_API_ORIGIN=https://dsh.xn--n6qv0quslfsn.top

# Packaged desktop default in source:
# https://dsh.xn--n6qv0quslfsn.top
#
# The community web build may instead choose a direct API base:
# VITE_COMMUNITY_API_BASE=https://dsh.xn--n6qv0quslfsn.top
